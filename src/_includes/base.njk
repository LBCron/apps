{#-
  Layout of every page: the shared header and footer of all lernapps.net sites (@lernapps/site, from
  lernapps.github.io), content for reading and the projector, in the light and, with the system's dark mode, in the dark scheme (data-la-theme="auto", apps.css).
  Front matter: title, description; optional: scripts (files in /assets/).
  Links to the home site (/, /privacy/, /docs/…) are root-relative on purpose: same origin, other repo.
  The usage counter of the platform sites (/lernapps-count.js, served by the home site, see "Usage counter" in its
  README) counts the catalog's pages, never in a preview. It is not part of laHead: apps use the site frame too, and
  apps are never counted.
-#}
{%- import "components.njk" as c with context -%}
<!doctype html>
<html lang="{{ lang }}" data-la-theme="auto">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ site.origin }}/apps{{ page.url }}">
  {%- if site.preview %}
  <meta name="robots" content="noindex">
  {%- endif %}
  {% laHead page.url %}
  {%- if not site.preview %}
  <script src="/lernapps-count.js" defer></script>
  {%- endif %}
  <link rel="stylesheet" href="{{ '/uno.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/apps.css' | url }}">
  {%- for script in scripts %}
  <script src="{{ ('/assets/' + script) | url }}" defer></script>
  {%- endfor %}
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col" style="font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;">
  {% laHeader page.url %}

  <main id="main-content" tabindex="-1" class="flex-1 outline-none">
    {{ content | safe }}
  </main>

  {% laFooter page.url %}
</body>
</html>
